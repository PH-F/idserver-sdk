{
  "name": "xingo/idserver-sdk",
  "description": "The Xingo IDServer SDK in PHP",
  "homepage": "http://github.com/PH-F/idserver-sdk",
  "authors": [
    {
      "name": "Junior Grossi",
      "email": "juniorgro@gmail.com",
      "homepage": "http://jgrossi.com"
    },
    {
      "name": "PH-F",
      "email": "info@ph-f.nl"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/auth": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/queue": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "symfony/http-foundation": "^6.0|^7.0|^8.0",
    "guzzlehttp/guzzle": "^6.3|~7|~8",
    "ext-intl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^9.6|^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Xingo\\IDServer\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Xingo\\IDServer\\ServiceProvider"
      ]
    }
  }
}
